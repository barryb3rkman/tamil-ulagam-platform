{
  "name": "tamil-ulagam-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Permanent digital platform foundation for Tamil Ulagam Global Federation.",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "node scripts/maintenance/prune-dev-cache.mjs && turbo build",
    "build:pages": "node scripts/maintenance/prune-dev-cache.mjs && turbo build",
    "lint": "node scripts/maintenance/prune-dev-cache.mjs && turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "node scripts/maintenance/prune-dev-cache.mjs && turbo typecheck",
    "test": "node scripts/maintenance/prune-dev-cache.mjs && turbo test",
    "test:watch": "turbo test:watch",
    "test:e2e": "turbo test:e2e",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset --local",
    "supabase:db:lint": "supabase db lint --local --level warning",
    "supabase:types": "supabase gen types typescript --local --schema public > apps/web/src/lib/supabase/database.types.ts && prettier --write apps/web/src/lib/supabase/database.types.ts",
    "test:supabase": "sh supabase/tests/run-local-integration.sh",
    "test:e2e:supabase": "sh supabase/tests/run-local-e2e.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean",
    "cache:check": "node scripts/maintenance/prune-dev-cache.mjs --check",
    "cache:prune": "node scripts/maintenance/prune-dev-cache.mjs --force",
    "cache:test": "node --test scripts/maintenance/prune-dev-cache.test.mjs",
    "clean:test-artifacts": "node scripts/maintenance/clean-test-artifacts.mjs",
    "test:functions": "node --test supabase/functions/_shared/email-template.test.ts supabase/functions/_shared/secret-keys.test.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.115.0",
    "turbo": "2.10.7",
    "typescript": "6.0.3"
  }
}
