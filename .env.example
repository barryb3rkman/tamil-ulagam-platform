# Canonical public origin used by metadata, robots, and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Empty for root hosting; set to /tamil-ulagam-platform for GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# Public Supabase browser configuration. Use the local values from `pnpm supabase:status`
# during development and configure deployment values in the hosting environment.
NEXT_PUBLIC_ENROLLMENT_BACKEND=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public CAPTCHA configuration. Leave both empty until the matching provider is
# enabled in Supabase Auth. Supported providers: turnstile, hcaptcha.
NEXT_PUBLIC_AUTH_CAPTCHA_PROVIDER=
NEXT_PUBLIC_AUTH_CAPTCHA_SITE_KEY=
