{
  "extends": "@tamil-ulagam/config-typescript/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.pages.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
